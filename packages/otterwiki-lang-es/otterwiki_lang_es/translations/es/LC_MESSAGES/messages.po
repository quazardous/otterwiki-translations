msgid_plural "%(num)s weeks"
msgstr[0] "%(num)s semana"
msgstr[1] "%(num)s semanas"

#: otterwiki/server.py:462
#, python-format
msgid "%(num)s day"
msgid_plural "%(num)s days"
msgstr[0] "%(num)s día"
msgstr[1] "%(num)s días"

#: otterwiki/server.py:463
#, python-format
msgid "%(num)s hour"
msgid_plural "%(num)s hours"
msgstr[0] "%(num)s hora"
msgstr[1] "%(num)s horas"

#: otterwiki/server.py:464
#, python-format
msgid "%(num)s min"
msgid_plural "%(num)s mins"
msgstr[0] "%(num)s min"
msgstr[1] "%(num)s min"

#: otterwiki/server.py:465
#, python-format
