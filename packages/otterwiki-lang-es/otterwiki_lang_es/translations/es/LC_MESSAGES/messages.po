msgstr "se une en un único párrafo."

#: otterwiki/templates/snippets/syntax.html:49
#: otterwiki/templates/snippets/syntax.html:57
msgid "Two trailing spaces"
msgstr "Dos espacios al final"

#: otterwiki/templates/snippets/syntax.html:50
#: otterwiki/templates/snippets/syntax.html:57
msgid "force a line break."
msgstr "fuerzan un salto de línea."

#: otterwiki/templates/snippets/syntax.html:52
#: otterwiki/templates/snippets/syntax.html:58
msgid "A trailing backslash"
msgstr "Una barra invertida al final"

#: otterwiki/templates/snippets/syntax.html:53
#: otterwiki/templates/snippets/syntax.html:58
msgid "forces a line break, too."
msgstr "también fuerza un salto de línea."

#: otterwiki/templates/snippets/syntax.html:61
msgid ""
"Note: Trailing spaces are invisible in the editor, so the trailing "
"backslash is often the more practical choice. See the <a "
"href=\"https://www.markdownguide.org/basic-syntax/#line-breaks\">Markdown"
" Guide</a> for details."
msgstr ""
"Nota: los espacios al final de la línea no se ven en el editor, por lo "
"que la barra invertida final suele ser la opción más práctica. Consulta "
"la <a href=\"https://www.markdownguide.org/basic-syntax/#line-"
"breaks\">Markdown Guide</a> para más detalles."

