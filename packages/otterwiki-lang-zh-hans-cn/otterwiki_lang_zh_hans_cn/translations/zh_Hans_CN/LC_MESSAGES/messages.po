#: otterwiki/templates/edit_attachment.html:53
#: otterwiki/templates/history.html:49
msgid "Author"
msgstr "作者"

#: otterwiki/renderer_embeddings.py:1156 otterwiki/renderer_embeddings.py:1271
#: otterwiki/templates/attachments.html:41
#: otterwiki/templates/edit_attachment.html:54
msgid "Comment"
msgstr "备注"

#: otterwiki/renderer_embeddings.py:1236
msgid "Display attachments to the current page as list."
msgstr "以列表形式显示当前页面的附件。"

#: otterwiki/renderer_embeddings.py:1252
#, python-format
msgid ""
"With format you can decide what is displayed in the table: %(minimal)s "
"shows only the filenames, %(details)s shows filename, date and size, "
"%(full)s shows all information."
msgstr ""
"通过 format 可以决定表格中显示的内容：%(minimal)s 只显示文件名，%(details)s "
"显示文件名、日期和大小，%(full)s 显示全部信息。"

#: otterwiki/renderer_embeddings.py:1286
msgid "Render a page index listing all pages below the current page."
msgstr "显示列出当前页面下所有页面的页面索引。"

#: otterwiki/renderer_embeddings.py:1306
msgid ""
"Display a page index listing pages below the current page,\n"
"optionally filtered by a glob pattern."
msgstr ""
"显示列出当前页面下各页面的页面索引，\n"
"可选择按 glob 模式进行筛选。"

#: otterwiki/renderer_embeddings.py:1321 otterwiki/renderer_embeddings.py:1626
msgid "Options:"
msgstr "选项："

#: otterwiki/renderer_embeddings.py:1325
#, python-format
msgid ""
"glob pattern to filter pages by title (default %(default)s, matches all "
"pages)"
msgstr "按标题筛选页面的 glob 模式（默认为 %(default)s，匹配所有页面）"

#: otterwiki/renderer_embeddings.py:1331
#, python-format
msgid ""
"%(pageindex)s for the default letter-grouped layout, %(list)s for a plain"
" unordered list (default %(pageindex)s)"
msgstr "%(pageindex)s 表示默认的按字母分组布局，%(list)s 表示普通的无序列表（默认为 %(pageindex)s）"

#: otterwiki/renderer_embeddings.py:1338
#, python-format
msgid ""
"show page headings (default %(default)s; for %(style_list)s headings are "
"rendered as nested sublists)"
msgstr "显示页面标题（默认为 %(default)s；使用 %(style_list)s 时，标题渲染为嵌套的子列表）"

#: otterwiki/renderer_embeddings.py:1345
#, python-format
msgid ""
"show the toggle for the page headings (default %(default)s, ignored for "
"%(style_list)s)"
msgstr "显示页面标题的切换按钮（默认为 %(default)s，使用 %(style_list)s 时忽略此项）"

#: otterwiki/renderer_embeddings.py:1420 otterwiki/templates/pageindex.html:23
msgid "Toggle page headings"
msgstr "切换页面标题"

#: otterwiki/renderer_embeddings.py:1440
msgid "Wrap content in a figure with an optional caption."
msgstr "将内容包裹在带可选题注的插图（figure）中。"

#: otterwiki/renderer_embeddings.py:1456
msgid ""
"A container for emphasizing content blocks (code, tables, images, etc.)\n"
"with an optional caption — similar to a LaTeX figure."
msgstr ""
"用于突出显示内容块（代码、表格、图片等）的容器，\n"
"可带题注，类似于 LaTeX 中的 figure。"

#: otterwiki/renderer_embeddings.py:1599
msgid "Transclude another page or one of its sections."
msgstr "嵌入包含另一个页面或其中的某个章节。"

#: otterwiki/renderer_embeddings.py:1614
msgid ""
"Include (transclude) the content of another page, or a single section of "
"it,\n"
"into the current page. The included content is rendered inline, "
"seamlessly."
msgstr ""
"将另一个页面的内容或其中的某个章节包含（嵌入）到当前页面中。\n"
"被包含的内容会以内联方式无缝渲染。"

#: otterwiki/renderer_embeddings.py:1630
#, python-format
msgid ""
"path of the page to include. Relative to the current page unless it\n"
"  starts with %(slash)s (absolute from the wiki root)."
msgstr ""
"要包含的页面路径。除非以 %(slash)s 开头（从 Wiki 根目录起的绝对路径），\n"
"  否则相对于当前页面。"

#: otterwiki/renderer_embeddings.py:1636
#, python-format
msgid ""
"the anchor slug of the heading to include, matched the same way\n"
"  heading links (%(link)s) are generated, independent of the heading\n"
"  level. If omitted the whole page is included."
msgstr ""
"要包含的标题的锚点标识，匹配方式与生成标题链接（%(link)s）的方式相同，\n"
"  与标题级别无关。\n"
"  如果省略，则包含整个页面。"

#: otterwiki/renderer_embeddings.py:1642
#, python-format
msgid ""
"include sub-sections of the section (default %(default)s). With\n"
"  %(children_false)s only the content directly under the heading is "
"included."
msgstr ""
"包含该章节的子章节（默认为 %(default)s）。\n"
"  使用 %(children_false)s 时，只包含直接位于该标题下的内容。"

#: otterwiki/renderer_embeddings.py:1649
#, python-format
msgid "include the section's own heading line (default %(default)s)."
msgstr "包含该章节自身的标题行（默认为 %(default)s）。"

#: otterwiki/renderer_embeddings.py:1655
msgid "Limitations:"
msgstr "限制："

#: otterwiki/renderer_embeddings.py:1659
#, python-format
msgid ""
"Relative links and attachments (e.g. %(example)s) in the included\n"
"  content resolve against the *including* page, not the source page, so "
"they\n"
"  may break. Use absolute paths (%(absolute)s) in content that is\n"
"  meant to be included."
msgstr ""
"被包含内容中的相对链接和附件（例如 %(example)s）\n"
"  是相对于*包含它的*页面而非源页面解析的，\n"
"  因此可能会失效。\n"
"  在需要被包含的内容中，请使用绝对路径（%(absolute)s）。"

#: otterwiki/renderer_embeddings.py:1666
msgid ""
"Headings from included content do not appear in the including page's "
"table\n"
"  of contents."
msgstr ""
"被包含内容中的标题不会出现在\n"
"  包含它的页面的目录中。"

#: otterwiki/renderer_embeddings.py:1671
#, python-format
msgid ""
"Combining a stateful embedding such as %(datatable)s with an %(include)s "
"on the\n"
"  same page may leave the page's own DataTable uninitialised. Put such\n"
"  embeddings on separate pages."
msgstr ""
"在同一页面上将 %(datatable)s 等有状态的嵌入与 %(include)s 组合使用，\n"
"  可能导致该页面自身的 DataTable 未被初始化。\n"
"  请将此类嵌入放在不同的页面上。"

#: otterwiki/renderer_embeddings.py:1678
msgid ""
"Includes are limited to a nesting depth of 8, and include cycles (a page\n"
"  including itself, directly or indirectly) are detected and reported "
"instead\n"
"  of being expanded."
msgstr ""
"包含的嵌套深度最多为 8 层；循环包含（页面直接或间接地包含自身）\n"
"  会被检测出来并报告，\n"
"  而不会被展开。"

#: otterwiki/renderer_embeddings.py:1709
#, python-format
msgid "include: invalid src \"%(src)s\", path traversal is not allowed."
msgstr "include：无效的 src \"%(src)s\"，不允许路径遍历。"

#: otterwiki/renderer_embeddings.py:1748
msgid "include: |src= is required."
msgstr "include：必须提供 |src=。"

#: otterwiki/renderer_embeddings.py:1759
#, python-format
msgid "include: page \"%(src)s\" not found."
msgstr "include：未找到页面 \"%(src)s\"。"

#: otterwiki/renderer_embeddings.py:1780
msgid "none"
msgstr "无"

#: otterwiki/renderer_embeddings.py:1783
#, python-format
msgid ""
"include: section \"%(section)s\" not found in \"%(src)s\" (available: "
"%(available)s)."
msgstr "include：在 \"%(src)s\" 中未找到章节 \"%(section)s\"（可用章节：%(available)s）。"

#: otterwiki/renderer_embeddings.py:1796
#, python-format
msgid "include: cycle detected including \"%(src)s\"."
msgstr "include：检测到循环包含 \"%(src)s\"。"

#: otterwiki/renderer_embeddings.py:1801
#, python-format
msgid "include: maximum include depth (%(depth)s) exceeded."
msgstr "include：超出最大包含深度（%(depth)s）。"

