msgstr "ImageFrame : pièce jointe « %(src)s » introuvable."

#: otterwiki/renderer_embeddings.py:726
msgid "Embed a video from an url or an attachment"
msgstr "Intégrer une vidéo depuis une URL ou une pièce jointe"

#: otterwiki/renderer_embeddings.py:741
msgid ""
"Embed a video player that supports video and audio playback in your "
"document,\n"
"or embed a YouTube video by providing a YouTube URL."
msgstr ""
"Intègre dans votre document un lecteur qui prend en charge la lecture "
"vidéo et audio,\n"
"ou une vidéo YouTube à partir de son URL."

#: otterwiki/renderer_embeddings.py:760
#, python-format
msgid ""
"YouTube URLs (%(long_url)s or %(short_url)s) are rendered as embedded "
"iframes:"
msgstr ""
"Les URL YouTube (%(long_url)s ou %(short_url)s) sont affichées dans une "
"iframe intégrée :"

#: otterwiki/renderer_embeddings.py:840
msgid "No src given."
msgstr "Aucun src indiqué."

#: otterwiki/renderer_embeddings.py:847
msgid "Cannot mix YouTube links and file sources in the same Video embedding."
msgstr ""
"Impossible de mélanger des liens YouTube et des fichiers dans une même "
"intégration Video."

#: otterwiki/renderer_embeddings.py:874
msgid "YouTube video player"
msgstr "Lecteur vidéo YouTube"

#: otterwiki/renderer_embeddings.py:892
msgid "Your browser does not support the video tag."
msgstr "Votre navigateur ne prend pas en charge la balise vidéo."

#: otterwiki/renderer_embeddings.py:905
msgid ""
"Render structured information next to the main content in a standardized "
"way"
msgstr ""
"Affiche des informations structurées à côté du contenu principal, de "
"façon normalisée"

#: otterwiki/renderer_embeddings.py:921
msgid "An element for displaying structured data in a document."
msgstr "Un élément pour afficher des données structurées dans un document."

#: otterwiki/renderer_embeddings.py:947
#, python-format
msgid ""
"Note: On small screens the box automatically expands to full width "
"regardless of the %(width)s option.\n"
"The optional %(style)s allows additional inline CSS overrides."
msgstr ""
"Remarque : sur les petits écrans, l'encadré s'étend automatiquement sur "
"toute la largeur, quelle que soit l'option %(width)s.\n"
"L'option facultative %(style)s permet d'ajouter des surcharges CSS en "
"ligne."

#: otterwiki/renderer_embeddings.py:1092
msgid "Render the attachments to the current page as table."
msgstr "Affiche les pièces jointes de la page courante sous forme de tableau."

#: otterwiki/renderer_embeddings.py:1147 otterwiki/renderer_embeddings.py:1152
#: otterwiki/renderer_embeddings.py:1263
msgid "Attachment"
msgstr "Pièce jointe"

#: otterwiki/renderer_embeddings.py:1149 otterwiki/renderer_embeddings.py:1153
#: otterwiki/renderer_embeddings.py:1265
#: otterwiki/templates/attachments.html:38
msgid "Size"
msgstr "Taille"

