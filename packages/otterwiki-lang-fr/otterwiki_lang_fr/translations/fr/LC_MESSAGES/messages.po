#: otterwiki/renderer_embeddings.py:1267
#: otterwiki/templates/attachments.html:39
#: otterwiki/templates/changelog.html:73 otterwiki/templates/diff.html:64
#: otterwiki/templates/edit_attachment.html:52
#: otterwiki/templates/history.html:48
msgid "Date"
msgstr "Date"

#: otterwiki/renderer_embeddings.py:1149
#: otterwiki/templates/attachments.html:37
msgid "Filename"
msgstr "Nom du fichier"

#: otterwiki/renderer_embeddings.py:1155 otterwiki/renderer_embeddings.py:1269
#: otterwiki/templates/attachments.html:40
#: otterwiki/templates/changelog.html:74 otterwiki/templates/diff.html:65
#: otterwiki/templates/edit_attachment.html:53
#: otterwiki/templates/history.html:49
msgid "Author"
msgstr "Auteur"

#: otterwiki/renderer_embeddings.py:1156 otterwiki/renderer_embeddings.py:1271
#: otterwiki/templates/attachments.html:41
#: otterwiki/templates/edit_attachment.html:54
msgid "Comment"
msgstr "Commentaire"

#: otterwiki/renderer_embeddings.py:1236
msgid "Display attachments to the current page as list."
msgstr "Affiche les pièces jointes de la page courante sous forme de liste."

#: otterwiki/renderer_embeddings.py:1252
#, python-format
msgid ""
"With format you can decide what is displayed in the table: %(minimal)s "
"shows only the filenames, %(details)s shows filename, date and size, "
"%(full)s shows all information."
msgstr ""
"L'option format détermine ce qui est affiché dans le tableau : "
"%(minimal)s n'affiche que les noms de fichiers, %(details)s affiche le "
"nom, la date et la taille, %(full)s affiche toutes les informations."

#: otterwiki/renderer_embeddings.py:1286
msgid "Render a page index listing all pages below the current page."
msgstr "Affiche un index de toutes les pages situées sous la page courante."

#: otterwiki/renderer_embeddings.py:1306
msgid ""
"Display a page index listing pages below the current page,\n"
"optionally filtered by a glob pattern."
msgstr ""
"Affiche un index des pages situées sous la page courante,\n"
"éventuellement filtrées par un motif glob."

#: otterwiki/renderer_embeddings.py:1321 otterwiki/renderer_embeddings.py:1626
msgid "Options:"
msgstr "Options :"

#: otterwiki/renderer_embeddings.py:1325
#, python-format
msgid ""
"glob pattern to filter pages by title (default %(default)s, matches all "
"pages)"
msgstr ""
"motif glob pour filtrer les pages par titre (par défaut %(default)s, "
"toutes les pages)"

#: otterwiki/renderer_embeddings.py:1331
#, python-format
msgid ""
"%(pageindex)s for the default letter-grouped layout, %(list)s for a plain"
" unordered list (default %(pageindex)s)"
msgstr ""
"%(pageindex)s pour la présentation par défaut groupée par lettre, "
"%(list)s pour une simple liste à puces (par défaut %(pageindex)s)"

#: otterwiki/renderer_embeddings.py:1338
#, python-format
msgid ""
"show page headings (default %(default)s; for %(style_list)s headings are "
"rendered as nested sublists)"
msgstr ""
"afficher les titres des pages (par défaut %(default)s ; avec "
"%(style_list)s, les titres sont affichés en sous-listes imbriquées)"

#: otterwiki/renderer_embeddings.py:1345
#, python-format
msgid ""
"show the toggle for the page headings (default %(default)s, ignored for "
"%(style_list)s)"
msgstr ""
"afficher le bouton pour afficher/masquer les titres des pages (par défaut"
" %(default)s, ignoré avec %(style_list)s)"

#: otterwiki/renderer_embeddings.py:1420 otterwiki/templates/pageindex.html:23
msgid "Toggle page headings"
msgstr "Afficher/masquer les titres des pages"

#: otterwiki/renderer_embeddings.py:1440
msgid "Wrap content in a figure with an optional caption."
msgstr "Place le contenu dans une figure avec une légende facultative."

#: otterwiki/renderer_embeddings.py:1456
msgid ""
"A container for emphasizing content blocks (code, tables, images, etc.)\n"
"with an optional caption — similar to a LaTeX figure."
msgstr ""
"Un conteneur pour mettre en valeur des blocs de contenu (code, tableaux, "
"images, etc.)\n"
"avec une légende facultative, à la manière d'une figure LaTeX."

#: otterwiki/renderer_embeddings.py:1599
msgid "Transclude another page or one of its sections."
msgstr "Inclut une autre page ou l'une de ses sections."

#: otterwiki/renderer_embeddings.py:1614
msgid ""
"Include (transclude) the content of another page, or a single section of "
"it,\n"
"into the current page. The included content is rendered inline, "
"seamlessly."
msgstr ""
"Inclut (transclusion) le contenu d'une autre page, ou d'une seule de ses "
"sections,\n"
"dans la page courante. Le contenu inclus est affiché en ligne, sans "
"démarcation."

#: otterwiki/renderer_embeddings.py:1630
#, python-format
msgid ""
"path of the page to include. Relative to the current page unless it\n"
"  starts with %(slash)s (absolute from the wiki root)."
msgstr ""
"chemin de la page à inclure. Relatif à la page courante, sauf s'il\n"
"  commence par %(slash)s (absolu depuis la racine du wiki)."

#: otterwiki/renderer_embeddings.py:1636
#, python-format
msgid ""
"the anchor slug of the heading to include, matched the same way\n"
"  heading links (%(link)s) are generated, independent of the heading\n"
"  level. If omitted the whole page is included."
msgstr ""
"l'ancre (slug) du titre à inclure, déterminée de la même façon que\n"
"  les liens vers les titres (%(link)s), quel que soit le niveau du\n"
"  titre. Si elle est omise, toute la page est incluse."

#: otterwiki/renderer_embeddings.py:1642
#, python-format
msgid ""
"include sub-sections of the section (default %(default)s). With\n"
"  %(children_false)s only the content directly under the heading is "
"included."
msgstr ""
"inclure les sous-sections de la section (par défaut %(default)s). Avec\n"
"  %(children_false)s, seul le contenu placé directement sous le titre est"
" inclus."

#: otterwiki/renderer_embeddings.py:1649
#, python-format
msgid "include the section's own heading line (default %(default)s)."
msgstr ""
"inclure la ligne de titre de la section elle-même (par défaut "
"%(default)s)."

#: otterwiki/renderer_embeddings.py:1655
msgid "Limitations:"
msgstr "Limites :"

#: otterwiki/renderer_embeddings.py:1659
#, python-format
msgid ""
"Relative links and attachments (e.g. %(example)s) in the included\n"
"  content resolve against the *including* page, not the source page, so "
"they\n"
"  may break. Use absolute paths (%(absolute)s) in content that is\n"
"  meant to be included."
msgstr ""
"Les liens et pièces jointes relatifs (par ex. %(example)s) du contenu\n"
"  inclus sont résolus par rapport à la page *qui inclut*, et non la page "
"source : ils\n"
"  peuvent donc être cassés. Utilisez des chemins absolus (%(absolute)s) "
"dans le contenu\n"
"  destiné à être inclus."

#: otterwiki/renderer_embeddings.py:1666
msgid ""
"Headings from included content do not appear in the including page's "
"table\n"
"  of contents."
msgstr ""
"Les titres du contenu inclus n'apparaissent pas dans la table des "
"matières\n"
"  de la page qui l'inclut."

#: otterwiki/renderer_embeddings.py:1671
#, python-format
msgid ""
"Combining a stateful embedding such as %(datatable)s with an %(include)s "
"on the\n"
"  same page may leave the page's own DataTable uninitialised. Put such\n"
"  embeddings on separate pages."
msgstr ""
"Combiner une intégration à état comme %(datatable)s avec un %(include)s "
"sur la\n"
"  même page peut empêcher l'initialisation du DataTable propre à la page."
" Placez ces\n"
"  intégrations sur des pages distinctes."

#: otterwiki/renderer_embeddings.py:1678
msgid ""
"Includes are limited to a nesting depth of 8, and include cycles (a page\n"
"  including itself, directly or indirectly) are detected and reported "
"instead\n"
"  of being expanded."
msgstr ""
"Les inclusions sont limitées à une profondeur d'imbrication de 8, et les "
"inclusions circulaires (une page\n"
"  qui s'inclut elle-même, directement ou indirectement) sont détectées et"
" signalées au lieu\n"
"  d'être développées."

#: otterwiki/renderer_embeddings.py:1709
#, python-format
msgid "include: invalid src \"%(src)s\", path traversal is not allowed."
msgstr ""
"include : src « %(src)s » non valide, la traversée de répertoires n'est "
"pas autorisée."

#: otterwiki/renderer_embeddings.py:1748
msgid "include: |src= is required."
msgstr "include : |src= est obligatoire."

#: otterwiki/renderer_embeddings.py:1759
#, python-format
msgid "include: page \"%(src)s\" not found."
msgstr "include : page « %(src)s » introuvable."

#: otterwiki/renderer_embeddings.py:1780
msgid "none"
msgstr "aucune"

#: otterwiki/renderer_embeddings.py:1783
#, python-format
msgid ""
"include: section \"%(section)s\" not found in \"%(src)s\" (available: "
"%(available)s)."
msgstr ""
"include : section « %(section)s » introuvable dans « %(src)s » "
"(disponibles : %(available)s)."

#: otterwiki/renderer_embeddings.py:1796
#, python-format
msgid "include: cycle detected including \"%(src)s\"."
msgstr "include : inclusion circulaire détectée pour « %(src)s »."

#: otterwiki/renderer_embeddings.py:1801
#, python-format
msgid "include: maximum include depth (%(depth)s) exceeded."
msgstr "include : profondeur d'inclusion maximale (%(depth)s) dépassée."

